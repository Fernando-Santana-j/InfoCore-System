<%
  const path = typeof currentPath !== 'undefined' ? currentPath : '';
  function navActive(href) {
    if (href === '/services') return path === '/services' || path.startsWith('/services/');
    return path === href;
  }
%>
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-icon" aria-hidden="true">
      <img src="/img/logo_bg.ico" alt="" width="32" height="32" decoding="async">
    </div>
    <div class="logo-text">Info<span>Core</span></div>
  </div>
  <nav class="sidebar-nav" aria-label="Menu principal">
    <div class="nav-section-label">Principal</div>
    <a href="/dashboard" class="nav-item<%= navActive('/dashboard') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">📊</span>
      <span class="nav-label">Dashboard</span>
    </a>
    <a href="/pdv" class="nav-item<%= navActive('/pdv') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">🛒</span>
      <span class="nav-label">PDV</span>
      <span class="badge green">Novo</span>
    </a>
    <% if (appData.user.type === 'admin') { %>
    <a href="/services" class="nav-item<%= navActive('/services') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">🧰</span>
      <span class="nav-label">Oficina</span>
    </a>
    <% } %>
    <a href="/budgets" class="nav-item<%= navActive('/budgets') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">📋</span>
      <span class="nav-label">Orçamentos</span>
    </a>
    <a href="/clients" class="nav-item<%= navActive('/clients') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">👥</span>
      <span class="nav-label">Clientes CRM</span>
    </a>
    <div class="nav-section-label">Gestão</div>
    <% if (appData.user.type === 'admin') { %>
    <a href="/stock" class="nav-item<%= navActive('/stock') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">📦</span>
      <span class="nav-label">Catálogo</span>
      <span class="badge" id="lowStockBadge" style="display:none">!</span>
    </a>
    <% } %>
    <a href="/cash-flow" class="nav-item<%= navActive('/cash-flow') ? ' active' : '' %>">
      <span class="nav-icon" aria-hidden="true">📒</span>
      <span class="nav-label">Fluxo de caixa</span>
    </a>
  </nav>
  <div class="sidebar-bottom">
    <div class="user-card">
      <div class="user-avatar" aria-hidden="true"><%= (appData.user.name || 'IC').slice(0, 2).toUpperCase() %></div>
      <div class="user-info">
        <div class="user-name"><%= appData.user.name %></div>
        <div class="user-role"><%= appData.user.type %></div>
      </div>
    </div>
  </div>
</aside>
