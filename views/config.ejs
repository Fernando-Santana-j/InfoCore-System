<% const cfg = appData.configs && !appData.configs.error ? appData.configs : {}; %>
<div class="page" id="page-configuracoes">
  <div class="grid-2 gap-20">
    <div class="card wa-config-card" id="waConfigCard">
      <div class="card-header">
        <div class="card-title">💬 WhatsApp da Loja</div>
        <span class="wa-status-pill" id="waStatusPill">Verificando...</span>
      </div>
      <p class="wa-config-desc">Conecte o WhatsApp da loja escaneando o QR Code (Baileys). Orçamentos e relatórios de OS serão enviados por este número.</p>
      <div class="wa-config-body">
        <div class="wa-qr-panel" id="waQrPanel" hidden>
          <p class="wa-qr-hint">Abra o WhatsApp no celular → Aparelhos conectados → Conectar aparelho</p>
          <img id="waQrImg" alt="QR Code WhatsApp" width="280" height="280">
        </div>
        <div class="wa-connected-panel" id="waConnectedPanel" hidden>
          <div class="wa-connected-icon">✓</div>
          <p>Conectado como <strong id="waConnectedPhone">—</strong></p>
        </div>
        <p class="wa-error" id="waErrorMsg" hidden></p>
        <div class="wa-config-actions">
          <button type="button" class="btn btn-primary btn-sm" id="waConnectBtn">Conectar / Gerar QR</button>
          <button type="button" class="btn btn-ghost btn-sm" id="waDisconnectBtn" hidden>Desconectar</button>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><div class="card-title">🏪 Dados da Loja</div></div>
      <div class="flex-col gap-14">
        <div class="form-group">
          <label class="form-label">Nome da Loja</label>
          <input class="form-input" id="storeName" value="<%= cfg.storeName || cfg.name || '' %>" placeholder="Nome exibido em propostas e relatórios">
        </div>
        <div class="form-group">
          <label class="form-label">CNPJ</label>
          <input class="form-input mono" id="storeDoc" value="<%= cfg.storeDoc || cfg.cnpj || '' %>" placeholder="00.000.000/0001-00">
        </div>
        <div class="form-group">
          <label class="form-label">Endereço</label>
          <input class="form-input" id="storeAddress" value="<%= cfg.storeAddress || cfg.address || '' %>" placeholder="Endereço da empresa">
        </div>
        <div class="form-group">
          <label class="form-label">Telefone</label>
          <input class="form-input" id="storePhone" value="<%= cfg.storePhone || cfg.phone || '' %>" placeholder="(00) 00000-0000">
        </div>
        <button type="button" class="btn btn-primary btn-sm w-full" id="saveStoreBtn">💾 Salvar dados</button>
      </div>
    </div>

    <div class="card config-health-card"><div class="card-header"><div class="card-title">⚡ Estado do sistema</div><span class="tag green">Operacional</span></div><div class="config-health-list"><div><span>Banco de dados</span><strong>Firebase conectado</strong></div><div><span>Catálogo</span><strong>Schema v2</strong></div><div><span>Cache</span><strong>Otimizado</strong></div></div><p class="text-xs text-muted">As configurações desta tela são aplicadas aos documentos, propostas e rotinas da plataforma.</p></div>

    <div class="card">
      <div class="card-header"><div class="card-title">🎨 Preferências</div></div>
      <div class="flex-col gap-14">
        <div class="form-group">
          <label class="form-label">Moeda</label>
          <select class="form-select" id="currency"><option value="BRL">BRL — Real Brasileiro</option></select>
        </div>
        <div class="form-group">
          <label class="form-label">Estoque mínimo padrão</label>
          <input class="form-input" id="defaultMinStock" type="number" min="0" max="999999" value="<%= Number.isFinite(Number(cfg.defaultMinStock)) ? Number(cfg.defaultMinStock) : 10 %>">
        </div>
        <button type="button" class="btn btn-primary btn-sm w-full" id="savePreferencesBtn">💾 Salvar preferências</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><div class="card-title">🔐 Segurança</div></div>
      <div class="flex-col gap-14">
        <div class="form-group">
          <label class="form-label">Senha Atual</label>
          <input class="form-input" id="currentPassword" type="password" autocomplete="current-password" placeholder="••••••••">
        </div>
        <div class="form-group">
          <label class="form-label">Nova Senha</label>
          <input class="form-input" id="newPassword" type="password" minlength="6" autocomplete="new-password" placeholder="Mínimo de 6 caracteres">
        </div>
        <div class="form-group">
          <label class="form-label">Confirmar Nova Senha</label>
          <input class="form-input" id="confirmPassword" type="password" minlength="6" autocomplete="new-password" placeholder="Repita a nova senha">
        </div>
        <button type="button" class="btn btn-primary btn-sm w-full" id="changePasswordBtn">🔒 Alterar senha</button>
      </div>
    </div>
  </div>
</div>
