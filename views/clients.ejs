<div class="page clients-page" id="page-clientes">
  <div class="crm-hero card">
    <div class="crm-hero-copy">
      <p class="crm-kicker">Relacionamento · Atendimento</p>
      <h2 class="crm-title">Clientes CRM</h2>
      <p class="crm-subtitle">Guarde contatos, acompanhe atendimentos e encontre quem está procurando um produto.</p>
    </div>
    <div class="crm-hero-actions">
      <div class="search-bar search-bar--stretch">
        <span class="crm-search-icon" aria-hidden="true">🔍</span>
        <input type="search" placeholder="Nome, telefone, email ou documento..." id="clientSearch" autocomplete="off">
      </div>
      <button class="btn btn-primary" type="button" onclick="openNewCustomerForm()"><span aria-hidden="true">✨</span> Novo cliente</button>
    </div>
  </div>

  <section class="card interest-panel" aria-labelledby="interestPanelTitle">
    <div class="interest-heading"><div><p class="crm-kicker">Oportunidades de venda</p><h3 id="interestPanelTitle">Produtos procurados</h3><p class="crm-subtitle">Chegou um notebook? Pesquise aqui quem estava procurando.</p></div><button type="button" class="btn btn-ghost btn-sm" id="interestRefresh">Atualizar</button></div>
    <div class="interest-filters"><label>Buscar interesse<input class="form-input" type="search" id="interestSearch" placeholder="Notebook, memória, nome ou telefone…"></label><label>Etapa<select class="form-input" id="interestFilter"><option value="active">Pendentes</option><option value="waiting">Aguardando produto</option><option value="contacted">Cliente avisado</option><option value="done">Atendidos</option><option value="cancelled">Cancelados</option><option value="all">Todos</option></select></label></div>
    <p id="interestCount" class="text-muted" role="status"></p><div id="interestList" class="interest-list"></div>
  </section>

  <div class="crm-shell">
    <aside class="card crm-list-card">
      <div class="crm-list-head">
        <span class="crm-count" id="clientListCount">0 clientes</span>
      </div>
      <div class="crm-scroll" id="clientListMount"></div>
    </aside>

    <section class="crm-detail" id="clientDetailMount">
      <div class="card crm-empty card--muted">
        <div class="crm-empty-inner">
          <div class="crm-empty-icon">👋</div>
          <p class="crm-empty-title">Selecione um cliente</p>
          <p class="crm-empty-text">Ou cadastre um novo para iniciar o histórico de requisições e observações.</p>
        </div>
      </div>
    </section>
  </div>
</div>

<div class="modal-overlay" id="modal-customerForm">
  <div class="modal modal--wide">
    <div class="modal-header">
      <div class="modal-title" id="customerModalTitle">Novo cliente</div>
      <button class="modal-close" type="button" onclick="closeModal('customerForm')">✕</button>
    </div>
    <input type="hidden" id="editCustomerId" value="">
    <div class="form-grid client-form-grid">
      <div class="form-group">
        <label class="form-label" for="custName">Nome completo</label>
        <input class="form-input" id="custName" placeholder="Maria Souza Silva" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="custDoc">CPF / CNPJ</label>
        <input class="form-input mono" id="custDoc" placeholder="000.000.000-00">
      </div>
      <div class="form-group">
        <label class="form-label" for="custPhone">Telefone / WhatsApp</label>
        <input class="form-input" id="custPhone" placeholder="(11) 99999-9999">
      </div>
      <div class="form-group">
        <label class="form-label" for="custEmail">Email</label>
        <input class="form-input" id="custEmail" type="email" placeholder="contato@exemplo.com">
      </div>
      <div class="form-group form-full">
        <label class="form-label" for="custAddress">Endereço</label>
        <input class="form-input" id="custAddress" placeholder="Rua, número, bairro, cidade">
      </div>
      <div class="form-group form-full">
        <label class="form-label" for="custNotes">Descrição · observações internas</label>
        <textarea class="form-input textarea" id="custNotes" rows="3" placeholder="Preferências, combinados, garantias, notas rápidas..."></textarea>
      </div>
    </div>
    <div class="modal-footer modal-footer--split">
      <button class="btn btn-ghost" type="button" onclick="closeModal('customerForm')">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="submitCustomerForm()">Salvar cadastro</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-requestForm">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">Nova requisição</div>
      <button class="modal-close" type="button" onclick="closeModal('requestForm')">✕</button>
    </div>
    <div class="form-grid">
      <div class="form-group form-full">
        <label class="form-label" for="reqTitle">Título ou resumo</label>
        <input class="form-input" id="reqTitle" placeholder="Instalação, orçamento, suporte técnico...">
      </div>
      <div class="form-group">
        <label class="form-label" for="reqDate">Quando solicitou</label>
        <input class="form-input" id="reqDate" type="date">
      </div>
      <div class="form-group">
        <label class="form-label" for="reqStatus">Status</label>
        <select class="form-input" id="reqStatus">
          <option value="open">Aberta</option>
          <option value="in_progress">Em andamento</option>
          <option value="done">Concluída</option>
          <option value="cancelled">Cancelada</option>
        </select>
      </div>
      <div class="form-group form-full">
        <label class="form-label" for="reqDescription">Descrição detalhada</label>
        <textarea class="form-input textarea" id="reqDescription" rows="4" placeholder="O que foi pedido, prazos combinados, peças, valores citados…"></textarea>
      </div>
    </div>
    <div class="modal-footer modal-footer--split">
      <button class="btn btn-ghost" type="button" onclick="closeModal('requestForm')">Cancelar</button>
      <button class="btn btn-primary" type="button" onclick="submitNewRequest()">Registrar requisição</button>
    </div>
  </div>
</div>

<dialog id="interestDialog" class="interest-dialog" aria-labelledby="interestDialogTitle">
  <form id="interestForm">
    <header class="interest-heading"><div><p class="crm-kicker" id="interestCustomerLabel"></p><h3 id="interestDialogTitle">Registrar interesse</h3></div><button class="btn btn-ghost" type="button" id="interestClose" aria-label="Fechar interesse">✕</button></header>
    <p class="text-muted">Registre o que o cliente procura para entrar em contato quando estiver disponível.</p>
    <label>Produto procurado *<input class="form-input" name="title" maxlength="120" required placeholder="Ex.: notebook para estudar"></label>
    <label>Detalhes e preferências<textarea class="form-input" name="notes" maxlength="1000" rows="3" placeholder="Marca, memória, tamanho, novo ou usado, prazo desejado…"></textarea></label>
    <div class="interest-filters"><label>Valor máximo (opcional)<input class="form-input" name="maxBudget" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="R$"></label><label>Etapa<select class="form-input" name="status"><option value="waiting">Aguardando produto</option><option value="contacted">Cliente avisado</option><option value="done">Atendido</option><option value="cancelled">Cancelado</option></select></label></div>
    <p role="status" id="interestSaveStatus"></p>
    <footer class="interest-actions"><button class="btn btn-ghost" type="button" id="interestCancel">Cancelar</button><button class="btn btn-primary" type="submit">Salvar interesse</button></footer>
  </form>
</dialog>
