<div class="page" id="page-pdv">
  <div class="pdv-layout">
    <div class="pdv-products">
      <div class="pdv-toolbar">
        <div class="pdv-input-fields">
          <input type="text" id="pdvBarcodeCapture" class="visually-hidden" tabindex="-1" aria-label="Leitor de código de barras" autocomplete="off" spellcheck="false">
          <label class="pdv-input-field" for="pdvSearch">
            <span>Pesquisar produtos <kbd>F4</kbd></span>
            <div class="search-bar">
              <span aria-hidden="true">🔍</span>
              <input type="text" placeholder="Pesquisar por nome ou código…" id="pdvSearch" autocomplete="off" oninput="filterPDV(this.value)">
            </div>
          </label>
        </div>
        <div class="pdv-scan-status" id="pdvScanIndicator" title="Leitura automática de códigos com 8 números">
          <span class="pdv-scan-dot" aria-hidden="true"></span> Leitor ativo
        </div>
        <small id="pdvLastScan" role="status" aria-live="polite"></small>
        <div class="filter-bar">
          <button class="filter-btn active" onclick="setPDVFilter('todos',this)">Todos</button>
          <button class="filter-btn" onclick="setPDVFilter('produtos',this)">📦 Produtos</button>
          <button class="filter-btn" onclick="setPDVFilter('servicos',this)">🔧 Serviços</button>
        </div>
        <button type="button" class="btn btn-ghost btn-sm" id="btnOpenServiceIntakeModal">+ Solicitar análise</button>
        <% if (appData.user.type === 'admin') { %><a class="btn btn-ghost btn-sm" href="/budgets?new=1">+ Novo orçamento</a><% } %>
        <% if (appData.user.type === 'admin') { %>
        <a class="btn btn-ghost btn-sm" href="/stock" title="Cadastrar produtos e serviços">📋 Catálogo</a>
        <% } %>
        <a class="btn btn-ghost btn-sm" href="/budgets">Ver orçamentos</a>
      </div>
      <div class="pdv-products-grid" id="pdvGrid"></div>
    </div>

    <div class="cart-panel">
      <div class="cart-header">
        <div class="cart-header-row"><div><div class="cart-title">🛒 Venda atual</div><div class="text-xs text-muted mt-4" id="cartCount">0 itens</div></div><div class="pdv-held-actions"><button type="button" class="btn btn-ghost btn-sm" id="btnHoldSale" title="Atalho F8">Suspender</button></div></div>
        <label class="pdv-customer-field"><span>Cliente</span><input class="form-input" id="pdvCustomerName" list="pdvCustomerOptions" placeholder="Balcão ou nome do cliente" autocomplete="off"><datalist id="pdvCustomerOptions"></datalist></label>
      </div>
      <div class="cart-items" id="cartItems">
        <div class="empty-state" id="cartEmpty">
          <div class="empty-icon">🛍️</div>
          <p>Nenhum item adicionado</p>
        </div>
      </div>
      <div class="cart-footer">
        <label class="pdv-sale-note"><span>Observação da venda</span><input class="form-input" id="pdvSaleNote" maxlength="500" placeholder="Opcional: garantia, retirada, referência..."></label>
        <div class="cart-totals">
          <div class="cart-total-row"><span>Subtotal</span><span class="val mono" id="cartSubtotal">R$ 0,00</span></div>
          <div class="cart-total-row"><span>Desconto</span><span class="val mono text-green" id="cartDiscount">- R$ 0,00</span></div>
          <div class="cart-total-row"><span>Acréscimo</span><span class="val mono text-red" id="cartExtra">+ R$ 0,00</span></div>
          <div class="divider"></div>
          <div class="cart-total-row grand"><span>Total</span><span class="val" id="cartTotal">R$ 0,00</span></div>
        </div>
        <% if (appData.user.type === 'admin') { %><div class="pdv-admin-metrics" id="pdvAdminMetrics"><span>Visão administrativa</span><strong>Lucro estimado: R$ 0,00</strong></div><% } %>
        <div class="payment-methods" id="paymentMethodsButtons"></div>
        <div class="cart-adjust-actions">
          <button class="btn btn-ghost btn-sm" type="button" id="btnOpenDiscountModal">Desconto</button>
          <button class="btn btn-ghost btn-sm" type="button" id="btnOpenExtraModal">Acréscimo</button>
        </div>
        <button class="btn btn-primary w-full" style="justify-content:center;" id="btnFinalizeSale" onclick="finalizarVenda()">✅ Finalizar Venda <kbd class="pdv-kbd-hint">F10</kbd></button>
        <button class="btn btn-ghost btn-sm w-full" style="justify-content:center;" onclick="clearCart()">🗑️ Limpar</button>
      </div>
    </div>
  </div>
  <details class="pdv-offline-details">
    <summary>Consulta offline</summary>
    <p id="pdvOfflineStatus" role="status" aria-live="polite"></p>
  </details>
</div>

<div class="pdv-modal-overlay" id="customItemModal">
  <div class="pdv-modal-card">
    <div class="pdv-modal-header">
      <div class="pdv-modal-title">Item personalizado</div>
      <button type="button" class="pdv-modal-close" id="closeCustomItemModalBtn" aria-label="Fechar">✕</button>
    </div>
    <div class="pdv-modal-body">
      <p class="text-sm text-muted mb-12">Serviço, taxa ou produto avulso — não desconta do estoque.</p>
      <div class="form-group">
        <label class="form-label" for="customItemName">Descrição</label>
        <input class="form-input" id="customItemName" type="text" placeholder="Ex.: Instalação de programa" maxlength="120" autocomplete="off">
      </div>
      <div class="form-grid">
        <div class="form-group">
          <label class="form-label" for="customItemPrice">Preço unitário (R$)</label>
          <input class="form-input" id="customItemPrice" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00">
        </div>
        <div class="form-group">
          <label class="form-label" for="customItemQty">Quantidade</label>
          <input class="form-input" id="customItemQty" type="number" min="1" step="1" value="1">
        </div>
      </div>
      <div class="pdv-custom-quick-prices" id="customItemQuickPrices">
        <button type="button" class="filter-btn" data-price="10">R$ 10</button>
        <button type="button" class="filter-btn" data-price="25">R$ 25</button>
        <button type="button" class="filter-btn" data-price="50">R$ 50</button>
        <button type="button" class="filter-btn" data-price="100">R$ 100</button>
      </div>
    </div>
    <div class="pdv-modal-footer">
      <button type="button" class="btn btn-ghost btn-sm" id="cancelCustomItemBtn">Cancelar</button>
      <button type="button" class="btn btn-primary btn-sm" id="saveCustomItemBtn">Adicionar ao carrinho</button>
    </div>
  </div>
</div>

<div class="pdv-modal-overlay" id="cartAdjustmentModal">
  <div class="pdv-modal-card pdv-adjustment-card">
    <div class="pdv-modal-header">
      <div class="pdv-modal-title" id="cartAdjustmentTitle">Ajustar valor</div>
      <button class="pdv-modal-close" id="closeCartAdjustmentModalBtn">✕</button>
    </div>
    <div class="pdv-modal-body">
      <p class="text-sm text-muted" id="cartAdjustmentHint">Escolha o tipo e o valor.</p>
      <div class="adjustment-type-group">
        <label class="adjustment-type-option">
          <input type="radio" name="adjustmentType" value="fixed" checked>
          <span>Valor fixo (R$)</span>
        </label>
        <label class="adjustment-type-option">
          <input type="radio" name="adjustmentType" value="percent">
          <span>Porcentagem (%)</span>
        </label>
      </div>
      <div class="adjustment-quick-values" id="cartAdjustmentQuickValues"></div>
      <input class="form-input" id="cartAdjustmentValue" type="number" min="0" step="0.01" placeholder="0,00">
    </div>
    <div class="pdv-modal-footer">
      <button class="btn btn-ghost btn-sm" id="cancelCartAdjustmentBtn">Cancelar</button>
      <button class="btn btn-primary btn-sm" id="saveCartAdjustmentBtn">Salvar</button>
    </div>
  </div>
</div>

<div class="pdv-modal-overlay" id="confirmActionModal">
  <div class="pdv-modal-card">
    <div class="pdv-modal-header">
      <div class="pdv-modal-title" id="confirmActionTitle">Confirmar ação</div>
      <button class="pdv-modal-close" id="closeConfirmActionModalBtn">✕</button>
    </div>
    <div class="pdv-modal-body">

      <p class="text-sm text-muted" id="confirmActionMessage">Deseja continuar?</p>
      <div class="pdv-stock-warning" id="confirmStockWarning" hidden></div>
      <div class="pdv-confirm-summary" id="confirmActionSummary">
        <div class="pdv-confirm-totals" id="confirmActionTotals"></div>
        <div id="splitPaymentSection" class="pdv-split-section">
          <label><input type="checkbox" id="splitPaymentEnabled"> Dividir entre meios de pagamento</label>
          <div id="splitPaymentFields" hidden>
            <p class="pdv-split-hint">Informe somente valores já recebidos. Pix e cartões devem ser conferidos fora deste fluxo; nenhuma nova cobrança será gerada.</p>
            <div class="pdv-split-shortcuts"><button type="button" class="btn btn-ghost btn-sm" id="splitHalfBtn">Metade Pix + metade dinheiro</button><button type="button" class="btn btn-ghost btn-sm" id="splitClearBtn">Limpar valores</button></div>
            <div class="pdv-split-grid">
              <% for (const [key, label] of [['pix','Pix'], ['money','Dinheiro'], ['debit_card','Débito'], ['credit_card','Crédito']]) { %>
                <label class="work-field"><%= label %> (R$)<input class="form-input" data-split-method="<%= key %>" type="number" min="0" step="0.01" inputmode="decimal" placeholder="0,00"><button type="button" class="pdv-split-fill" data-split-fill="<%= key %>">Completar restante em <%= label %></button></label>
              <% } %>
            </div>
            <div class="pdv-split-status"><span id="splitPaymentAllocated"></span><p id="splitPaymentBalance" role="status" aria-live="polite"></p></div>
            <label><input type="checkbox" id="splitPaymentConfirmed"> Conferi e recebi todos os valores informados.</label>
          </div>
        </div>
        <div id="pdvCreditInstallmentsSection" class="pdv-installments-section" hidden>
          <label class="pdv-installments-label">Parcelas no cartão de crédito</label>
          <p class="text-xs text-muted pdv-installments-hint">Juros por conta do cliente na maquininha.</p>
          <div class="pdv-installments-grid" id="creditInstallmentsButtons" role="group" aria-label="Número de parcelas"></div>
        </div>
        <div id="pdvCashPaymentSection" class="pdv-cash-section" hidden>
<label class="work-field">Sinal recebido (somente venda em dinheiro; vazio = pagamento integral)<input id="workInitialReceived" class="form-input" type="number" min="0" step="0.01" placeholder="Pagamento integral"></label>
          <label class="pdv-cash-label" for="pdvCashReceivedInput">Valor recebido (R$) <span class="text-muted" style="font-weight:500;">— opcional</span></label>
          <input class="form-input" type="number" id="pdvCashReceivedInput" min="0" step="0.01" inputmode="decimal" autocomplete="off" placeholder="Vazio = pagou o valor exato" aria-describedby="pdvCashPaymentHint">
          <div class="pdv-cash-change-row">
            <span>Troco</span>
            <strong class="mono" id="pdvCashChangeDisplay">R$ 0,00</strong>
          </div>
          <p class="text-xs text-muted" id="pdvCashPaymentHint">Só preencha se o cliente der um valor maior que o total (para calcular o troco). Se pagar em cédulas/moedas exatas, deixe em branco.</p>
        </div>
        <div class="pdv-confirm-items-wrap">
          <div class="text-xs text-muted">Itens da compra</div>
          <div class="pdv-confirm-items" id="confirmActionItems"></div>
        </div>
      </div>
    </div>
    <div class="pdv-modal-footer">
      <button class="btn btn-ghost btn-sm" id="cancelConfirmActionBtn">Cancelar</button>
      <button class="btn btn-primary btn-sm" id="confirmActionBtn">Confirmar</button>
    </div>
  </div>
</div>

<div class="pdv-modal-overlay" id="paymentWaitingModal">
  <div class="pdv-modal-card">
    <div class="pdv-modal-header">
      <div class="pdv-modal-title" id="paymentWaitingTitle">Aguardando pagamento</div>
      <button class="pdv-modal-close" id="closePaymentWaitingModalBtn">✕</button>
    </div>
    <div class="pdv-modal-body">
      <div class="pdv-payment-waiting-top">
        <div class="pdv-payment-loader" aria-hidden="true"></div>
        <div class="pdv-payment-status-wrap">
          <p class="text-sm text-muted" id="paymentWaitingMessage">Finalize o pagamento na maquininha.</p>
          <div class="pdv-payment-status-chip" id="paymentWaitingStatusChip">Iniciando cobrança...</div>
        </div>
      </div>
      <div id="paymentWaitingQrWrap" class="pdv-payment-qr-wrap" style="display:none;">
        <div id="paymentWaitingQrLoader" class="pdv-payment-qr-loader">
          <div class="pdv-payment-loader" aria-hidden="true"></div>
          <div class="text-xs text-muted">Gerando QR Code PIX...</div>
        </div>
        <img id="paymentWaitingQrImage" alt="QR Code PIX" class="pdv-payment-qr-image" />
      </div>
      <div id="paymentWaitingQrTextWrap" style="display:none;">
        <label class="text-xs text-muted" for="paymentWaitingQrText">Código PIX (copia e cola)</label>
        <textarea id="paymentWaitingQrText" class="form-input" rows="3" readonly></textarea>
        <button class="btn btn-ghost btn-sm mt-8" type="button" id="copyPixCodeBtn">Copiar código PIX</button>
      </div>
      <div class="text-xs text-muted mt-8" id="paymentWaitingHint">Não feche esta tela até o pagamento ser concluído.</div>
    </div>
    <div class="pdv-modal-footer">
      <button class="btn btn-ghost btn-sm" id="cancelPaymentWaitingBtn">Cancelar pagamento</button>
    </div>
  </div>
</div>

<%- include('reusable/request-modal') %>

<div class="pdv-modal-overlay" id="paymentResultModal">
  <div class="pdv-modal-card pdv-payment-result-card">
    <div class="pdv-modal-header">
      <div class="pdv-modal-title" id="paymentResultTitle">Resultado do pagamento</div>
      <button class="pdv-modal-close" id="closePaymentResultModalBtn">✕</button>
    </div>
    <div class="pdv-modal-body">
      <p class="text-sm text-muted" id="paymentResultMessage"></p>
      <div class="pdv-result-list" id="paymentResultDetails"></div>
    </div>
    <div class="pdv-modal-footer">
      <button class="btn btn-primary btn-sm" id="paymentResultOkBtn">Entendi</button>
    </div>
  </div>
</div>
