<div class="svc-admin-page">
  <header class="svc-admin-hero">
    <div>
      <h2>Oficina — Ordens de Serviço</h2>
      <p>Selecione uma ordem para abrir o fluxo de reparo item a item (descrição e fotos em cada etapa).</p>
    </div>
    <div class="svc-admin-hero-stats" id="svcAdminStats"></div>
  </header>

  <div class="svc-admin-layout svc-admin-layout--list">
    <section class="svc-admin-list svc-admin-list--full">
      <div class="search-bar">
        <span>🔎</span>
        <input type="search" id="serviceSearchInput" placeholder="Cliente, código OS, aparelho...">
      </div>
      <div class="svc-filter-chips" id="svcStatusFilters"></div>
      <div class="svc-order-list svc-order-list--grid" id="servicesList"></div>
    </section>
  </div>
</div>
