MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_DEVICE_ID=

# PIX sem taxa de Checkout: QR Code loja/caixa (external_id do POST /pos — ver documentação)
# https://www.mercadopago.com.br/developers/pt/docs/qr-code/create-store-and-pos
MERCADOPAGO_QR_EXTERNAL_POS_ID=
# Opcional: static | dynamic | hybrid (recomendado dynamic no PDV — QR e copia e cola por venda)
MERCADOPAGO_QR_MODE=dynamic

# Só usado se MERCADOPAGO_QR_EXTERNAL_POS_ID estiver vazio (PIX via /v1/payments — taxa Checkout)
MERCADOPAGO_PIX_PAYER_EMAIL=

# Base URL pública (opcional; se vazio, usa o host da requisição — recomendado em dev)
# Só defina em produção se o servidor não expõe o domínio correto em Host (proxy reverso).
APP_PUBLIC_BASE_URL=

# SMTP para envio automático de email de orçamento
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# WhatsApp (Baileys) — conecte em Configurações escaneando o QR Code
# WHATSAPP_AUTO_CONNECT=false  # desativa reconexão automática ao iniciar o servidor

# Firebase Admin (escolha UMA forma)
# 1) Caminho para o JSON da conta de serviço (recomendado em servidor próprio)
FIREBASE_SERVICE_ACCOUNT_FILE=
# 2) Ou JSON inteiro em uma variável de ambiente
FIREBASE_SERVICE_ACCOUNT_JSON=
# Se ambos estiverem vazios, o sistema tenta config/firebase-config.json e depois ADC do Google Cloud.
