MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_DEVICE_ID=

# PIX sem taxa de Checkout: QR Code loja/caixa (external_id do POST /pos — ver documentação)
# https://www.mercadopago.com.br/developers/pt/docs/qr-code/create-store-and-pos
MERCADOPAGO_QR_EXTERNAL_POS_ID=
# Opcional: static | dynamic | hybrid (recomendado dynamic no PDV — QR e copia e cola por venda)
MERCADOPAGO_QR_MODE=dynamic

# Só usado se MERCADOPAGO_QR_EXTERNAL_POS_ID estiver vazio (PIX via /v1/payments — taxa Checkout)
MERCADOPAGO_PIX_PAYER_EMAIL=

# Base URL pública da aplicação (ex: https://seudominio.com)
APP_PUBLIC_BASE_URL=

# SMTP para envio automático de email de orçamento
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Endpoint para envio automático de WhatsApp
# Espera POST JSON: { "to": "5599999999999", "message": "..." }
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
